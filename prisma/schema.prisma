// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// --- ENUMS (Статусы) ---
enum DropStatus {
  DRAFT     // Дроп готовится, еще не доступен для покупки
  LIVE      // Продажи открыты
  ARCHIVED  // Дроп завершен (все вещи проданы или время вышло)
}

enum OrderStatus {
  NEW
  RESERVED
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

// Добавь этот enum выше модели Item (например, после enum OrderStatus)
enum ItemCategory {
  CLOTHING
  ART
  ACCESSORY
}


// --- МОДЕЛИ (Таблицы) ---

model Drop {
  id          String      @id @default(uuid())
  title       String      // Название дропа, например: "Дроп 01: Черновик"
  description String?     // Описание концепции коллекции
  startDate   DateTime    // Дата и время старта продаж
  status      DropStatus  @default(DRAFT)
  createdAt   DateTime    @default(now())
  
  items       Item[]      // Связь: один дроп содержит много вещей
  
  @@map("drops")
}

model Item {
  id          String        @id @default(uuid())
  name        String
  description String
  price       Int
  stock       Int           @default(1)
  images      String[]      // Массив URL картинок
  measurements Json?        // Можно использовать и для одежды (груди/талия), и для арт (ширина/высота холста)
  
  // НОВОЕ ПОЛЕ: Категория товара
  category    ItemCategory  @default(CLOTHING)

  dropId      String
  drop        Drop          @relation(fields: [dropId], references: [id])
  orders      Order[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("items")
}

model Order {
  id                String      @id @default(uuid())
  itemId            String
  item              Item        @relation(fields: [itemId], references: [id])
  customerName      String
  telegramUsername  String
  phone             String?      // 
  status            OrderStatus @default(NEW)
  
  // Временные метки этапов
  reservedAt        DateTime?
  paidAt            DateTime?
  shippedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt @default(now())
  
  @@map("orders")
}